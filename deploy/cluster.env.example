# Git
REPO_URL="https://github.com/flakeman/team-cli-tracker.git"
REPO_DIR="/opt/team-cli-tracker"
REPO_BRANCH="main"

# Service user
APP_USER="teamtracker"
APP_GROUP="teamtracker"

# Go
GO_VERSION="1.25.0"

# Internal DNS resolver for private zone
INTERNAL_DNS="172.16.254.254"

# Node runtime defaults
NODE_ID="srv1"
LISTEN_ADDR=":4101"
DATA_DIR="/opt/team-cli-tracker/data"
NODE_PUBLIC_URL="http://srv1.abuztech.ru:4101"
NODE_LISTEN_ADDR="/ip4/0.0.0.0/tcp/4101"
NODE_PEERS="srv2,srv3"
NODE_PEERS_URLS="http://srv2.abuztech.ru:4101,http://srv3.abuztech.ru:4101"
PROJECT_ID="OPS"
SECURE_MODE_REQUIRED="true"

# Attachments backend:
# - local (dev fallback)
# - s3 (recommended for prod)
ATTACHMENT_BACKEND="s3"
ATTACHMENT_S3_ENDPOINT="s3.internal:9000"
ATTACHMENT_S3_BUCKET="team-cli-attachments"
ATTACHMENT_S3_ACCESS_KEY="minioadmin"
ATTACHMENT_S3_SECRET_KEY="minioadmin"
ATTACHMENT_S3_REGION="us-east-1"
ATTACHMENT_S3_SECURE="false"
