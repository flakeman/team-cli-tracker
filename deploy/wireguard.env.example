# Node identity
WG_NODE_ID="srv1"
WG_INTERFACE="wg0"
WG_PORT="51820"

# VPN subnet and node address
WG_SUBNET_CIDR="10.20.0.0/24"
WG_ADDRESS_CIDR="10.20.0.1/24"

# Private key for this node (base64, generated by wg genkey)
WG_PRIVATE_KEY=""

# Peers list:
# peer_name|peer_public_key|peer_endpoint_host:port|peer_allowed_ips_csv
# For internal-only no-NAT networks, endpoint may be empty.
WG_PEERS=""
# Example:
# WG_PEERS="srv2|<pubkey2>|srv2.example:51820|10.20.0.2/32,srv3|<pubkey3>|srv3.example:51820|10.20.0.3/32"

