# Gateway deployment mode:
# - public_proxy: direct public entrypoint on this host (DNS A/AAAA -> gateway host)
# - cloudflare_tunnel: publish via Cloudflare Tunnel (works without static public IP)
GATEWAY_MODE="public_proxy"

# Public board hostname used by clients.
# Example: board.example.com
BOARD_DOMAIN="board.example.com"

# Local listen port for gateway.
GATEWAY_LISTEN_PORT="8080"

# Upstream node endpoints (comma-separated).
# Use overlay/private addresses (Tailscale/ZeroTier) for reliability.
GATEWAY_UPSTREAMS="http://srv1.abuztech.ru:4101,http://srv2.abuztech.ru:4101,http://srv3.abuztech.ru:4101"

# Optional:
# Enable HTTPS in Caddy (recommended for internet exposure).
# For plain HTTP in private lab, set to false.
GATEWAY_ENABLE_TLS="true"

# Cloudflare Tunnel options (used when GATEWAY_MODE=cloudflare_tunnel).
# Requires `cloudflared` auth already configured on gateway host.
CLOUDFLARE_TUNNEL_NAME="team-cli-board"

